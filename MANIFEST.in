include LICENSE NOTICE README.md CHANGELOG.md setup.py
include .framenote.example.json
recursive-include skills/framenote *.md *.py
recursive-include plugins/framenote *.md *.json *.yaml
recursive-include deploy *.service *.example
recursive-include docs *.md
recursive-include tests *.py
prune docs/superpowers
prune .local
prune .superpowers
prune workspace
prune models
prune .runtime
prune .venv
prune .git
exclude service.env
exclude .framenote.json
prune .codex
exclude .DS_Store
global-exclude __pycache__ *.py[cod] .DS_Store
