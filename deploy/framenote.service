[Unit]
Description=FrameNote video materials service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=framenote
Group=framenote
WorkingDirectory=/opt/framenote
EnvironmentFile=/etc/framenote/service.env
Environment=FRAMENOTE_WORKSPACE=/var/lib/framenote
ExecStart=/opt/framenote/.venv/bin/python -m uvicorn framenote.service:app --host 0.0.0.0 --port 18121 --workers 1 --no-proxy-headers
StateDirectory=framenote
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Nice=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
