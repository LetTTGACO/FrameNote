FRAMENOTE_WORKSPACE=workspace
FRAMENOTE_ASR_BACKEND=sensevoice
FRAMENOTE_SENSEVOICE_MODEL=models/sensevoice
FRAMENOTE_VAD_MODEL=models/vad
# 默认使用服务当前 venv 的 Python；覆盖时该环境也必须安装 FrameNote 和 ASR 依赖。
# FRAMENOTE_ASR_PYTHON=/absolute/path/to/venv/bin/python
FRAMENOTE_ASR_THREADS=4
FRAMENOTE_PROCESS_TIMEOUT=7200
FRAMENOTE_MAX_UPLOAD_BYTES=2147483648
FRAMENOTE_GALAXY_ENABLED=false
FRAMENOTE_GALAXY_BASE_URL=https://downloader-api.bhwa233.com
# 客户端/stdio；挂载式 MCP 跟随当前应用。
FRAMENOTE_SERVICE_URL=http://127.0.0.1:18121
